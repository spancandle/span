{
  "name": "span-keeper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "keeper": "node --import tsx src/keeper/main.ts",
    "tape": "node --import tsx src/tape/main.ts",
    "settle": "node --import tsx src/cli/settle.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --reporter=verbose",
    "verify:tape": "python3 test/recalculate.py"
  },
  "dependencies": {
    "@solana-program/system": "0.15.0",
    "@solana-program/token": "0.17.0",
    "@solana-program/token-2022": "0.19.0",
    "@solana/kit": "8.4.0",
    "undici": "8.12.3"
  },
  "devDependencies": {
    "@types/node": "26.0.0",
    "tsx": "4.21.0",
    "typescript": "6.0.2",
    "vitest": "5.0.3",
    "ws": "8.22.0"
  }
}
